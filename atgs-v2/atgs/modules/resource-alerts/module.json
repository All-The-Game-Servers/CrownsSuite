{
  "id": "resource-alerts",
  "name": "Resource Alerts",
  "description": "Monitor CPU and RAM usage per instance. Alerts and auto-actions when thresholds are exceeded.",
  "version": "1.0.0",
  "scope": "instance",
  "sidecar": false,
  "defaultEnabled": true,
  "config": {
    "ramWarnPercent": { "type": "number", "default": 80, "label": "RAM warning threshold (%)" },
    "ramCriticalPercent": { "type": "number", "default": 95, "label": "RAM critical threshold (%)" },
    "cpuWarnPercent": { "type": "number", "default": 90, "label": "CPU warning threshold (%)" },
    "autoRestartOnCritical": { "type": "boolean", "default": false, "label": "Auto-restart on critical RAM" },
    "checkInterval": { "type": "number", "default": 30, "label": "Check interval (seconds)" }
  }
}
