{
  "id": "discord",
  "name": "Discord Integration",
  "description": "Webhook notifications for server events, player activity, crashes, and moderation actions.",
  "version": "1.0.0",
  "scope": "global",
  "sidecar": false,
  "defaultEnabled": false,
  "config": {
    "webhookUrl": { "type": "string", "default": "", "label": "Discord Webhook URL" },
    "notifyStart": { "type": "boolean", "default": true, "label": "Notify on server start" },
    "notifyStop": { "type": "boolean", "default": true, "label": "Notify on server stop" },
    "notifyJoin": { "type": "boolean", "default": true, "label": "Notify on player join" },
    "notifyLeave": { "type": "boolean", "default": true, "label": "Notify on player leave" },
    "notifyCrash": { "type": "boolean", "default": true, "label": "Notify on crash" },
    "notifyBackup": { "type": "boolean", "default": false, "label": "Notify on backup" },
    "notifyAccessGate": { "type": "boolean", "default": true, "label": "Notify on Access Gate kick" }
  }
}
